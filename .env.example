# ==============================================================================
# GetContact AI Agent — Environment Variables Template
# ==============================================================================
# Copy this file to '.env' for local development or '.env.production' for Docker.
# FILL IN YOUR ACTUAL KEYS BELOW.

# ------------------------------------------------------------------------------
# 1. CORE CREDENTIALS (REQUIRED)
# ------------------------------------------------------------------------------

# OpenAI API Key. STILL REQUIRED even when CHATGPT_OAUTH_ENABLED=true because:
#   (1) embeddings endpoint is not proxied — always hits api.openai.com
#   (2) automatic fallback when the chatgpt-proxy returns 429/401 or is down
# When the proxy is enabled and healthy, most calls route through the
# ChatGPT Plus/Pro subscription and this key is only used occasionally.
OPENAI_API_KEY=your_openai_api_key_here

# Serper.dev API Key for Google Search (Instagram handle finding)
SERPER_API_KEY=your_serper_api_key_here

# ------------------------------------------------------------------------------
# 1b. CHATGPT OAUTH (OPTIONAL — saves on API costs, in-process Python flow)
# ------------------------------------------------------------------------------
# Set to `true` after logging in once via:
#   - FE Settings -> ChatGPT tab -> Login with ChatGPT (browser callback), OR
#   - FE Manual paste (for headless / VPS deployments), OR
#   - FE Import ~/.codex/auth.json (if you have the official Codex CLI installed)
# No Docker sidecar — the OAuth flow runs in-process inside the orchestrator.
# See docs/chatgpt-oauth-setup.md for the full guide and ToS notice.
CHATGPT_OAUTH_ENABLED=false
CHATGPT_OAUTH_FALLBACK_TO_API=true
CHATGPT_OAUTH_RATE_LIMIT_COOLDOWN_SECONDS=900
# Originator string sent on every Codex backend request. Defaults to
# "codex_cli_rs" (matches the official Codex CLI). "openclaw" is also
# known-safe. Custom values may be flagged by OpenAI's anti-abuse systems.
CHATGPT_OAUTH_ORIGINATOR=codex_cli_rs

# OAuth Callback URL — determines which URL OpenAI redirects to after login.
# For local dev: http://localhost:1455/auth/callback (ephemeral server)
# For production: the public domain (e.g. https://getcontact.najworks.me/auth/codex-callback)
# If unset, defaults to localhost for dev.
# NOTE: This URL MUST be registered in your OpenAI app settings as an allowed
# redirect_uri. You can register multiple URIs to support both dev and prod.
OAUTH_CALLBACK_URL=http://localhost:1455/auth/callback

# ------------------------------------------------------------------------------
# 1c. SENTRY ERROR TRACKING (OPTIONAL)
# ------------------------------------------------------------------------------
# Sign up at https://sentry.io (free tier: 5K errors/month), create a new
# Python/FastAPI project, and paste the DSN below. When SENTRY_DSN is empty,
# orchestrator runs exactly as before — no tracking, no network calls.
#
# What gets captured automatically:
#   - Unhandled exceptions (FastAPI integration)
#   - httpx outbound HTTP 4xx/5xx + timeouts
#   - asyncio task unhandled errors
#   - log.error() breadcrumbs (not events)
# Explicit capture in orchestrator/llm/gateway.py:
#   - Codex OAuth auth errors (401/403)
#   - Codex upstream errors (5xx)
#
# PII protection (3 layers):
#   1. send_default_pii=False stops Sentry from auto-collecting cookies,
#      headers, request body, user IP
#   2. _before_send scrubber redacts sensitive dict keys (access tokens,
#      API keys, passwords, etc) — see orchestrator/observability.py
#   3. Regex masker auto-hides emails and Indonesian phone numbers in
#      freeform exception + breadcrumb strings
#
# See docs/observability-setup.md for full setup guide and alerting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Trace sampling rate (0.0-1.0). 0.1 (10%) fits free tier for typical
# traffic. Set to 1.0 for full visibility if on paid tier.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Release identifier — usually set by CI (e.g. $CI_COMMIT_SHORT_SHA).
# Leave empty for development; production deploys inject this automatically.
SENTRY_RELEASE=

# --- Optional advanced Sentry features (all OFF by default) ---
# Each of these burns extra quota. Enable only if you have headroom.
#
# SENTRY_ENABLE_LOGS — forward sentry_sdk.logger.* calls as structured
# log events to the Sentry Logs product. Separate quota from errors.
SENTRY_ENABLE_LOGS=false
#
# SENTRY_PROFILE_SESSION_SAMPLE_RATE — percentage of sessions to profile
# with flame graphs. 0.0 = off (default). 0.1 = profile 10% of sessions.
# Profiling uses performance-unit quota aggressively; watch usage.
SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.0
# SENTRY_PROFILE_LIFECYCLE — "trace" runs profiler during active
# transactions (recommended). "manual" requires explicit start/stop calls.
SENTRY_PROFILE_LIFECYCLE=trace
#
# SENTRY_SEND_DEFAULT_PII — override our privacy default. STRONGLY NOT
# RECOMMENDED for this app because we handle OAuth tokens, phone numbers,
# emails. Our custom scrubber is designed assuming PII is NOT auto-collected.
SENTRY_SEND_DEFAULT_PII=false
#
# SENTRY_DEBUG_ENABLED — exposes GET /health/sentry-debug endpoint that
# deliberately raises ZeroDivisionError. Use ONLY in dev/staging to verify
# Sentry capture works end-to-end. Keep OFF in production (would let users
# burn your Sentry quota with intentional errors).
SENTRY_DEBUG_ENABLED=false

# ------------------------------------------------------------------------------
# 2. INTERNAL SERVICE URLS (FOR DOCKER)
# ------------------------------------------------------------------------------

# URL for the WhatsApp Service (Node.js)
WA_SERVICE_URL=http://whatsapp:3100

# Webhook URL for the Orchestrator (used by WhatsApp Service to send replies back)
WEBHOOK_URL=http://orchestrator:8000/webhook/incoming

# ------------------------------------------------------------------------------
# 3. INSTAGRAM & SCRAPING (OPTIONAL / FALLBACKS)
# ------------------------------------------------------------------------------

# Instagram session cookie(s) for scraping (separate multiple with commas)
# Get from browser: F12 -> Application -> Cookies -> sessionid
IG_SESSION_ID=your_session_id_here

# Apify API Key (First-tier fallback for Instagram scraping)
APIFY_API_KEY=your_apify_api_key_here

# Scraping-Bot.io Credentials (Second-tier fallback)
SCRAPINGBOT_USERNAME=your_username
SCRAPINGBOT_API_KEY=your_api_key

# ------------------------------------------------------------------------------
# 4. DATABASE & STORAGE
# ------------------------------------------------------------------------------

# SQLite Database path inside the container
DATABASE_PATH=data/getcontact.db

# ------------------------------------------------------------------------------
# 5. OPERATION LIMITS & SCHEDULING
# ------------------------------------------------------------------------------

# Maximum new conversations to start per day
MAX_DAILY_CONVERSATIONS=20

# Minimum seconds between outgoing outreach messages
MIN_MESSAGE_GAP_SECONDS=300

# Outreach window (WIB Timezone / UTC+7)
OUTREACH_START_HOUR=7
OUTREACH_END_HOUR=22

# ------------------------------------------------------------------------------
# 6. EMAIL NOTIFICATIONS (SMTP/IMAP)
# ------------------------------------------------------------------------------

# --- Dashboard Auth (local session, DMS karyawan identity source) ---
AUTH_COOKIE_NAME=dms_marketing_session
AUTH_SESSION_TTL_HOURS=12
AUTH_COOKIE_SECURE=false
AUTH_DEFAULT_PASSWORD=
AUTH_DEFAULT_ROLE=viewer

SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_USERNAME=your_email@domain.com
SMTP_PASSWORD=your_password
SMTP_USE_SSL=true

IMAP_HOST=your_imap_host
IMAP_PORT=993
IMAP_USERNAME=your_email@domain.com
IMAP_PASSWORD=your_password
IMAP_USE_SSL=true