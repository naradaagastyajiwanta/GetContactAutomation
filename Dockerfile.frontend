# syntax=docker/dockerfile:1.6-labs

# Stage 1: Install dependencies using cache mounts for speed
FROM node:20-alpine AS deps
WORKDIR /app

# Copy package files (assuming context is project root)
COPY frontend/package*.json ./
# Use cache mount for faster builds
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --progress=false --legacy-peer-deps

# ── Stage 2: Build static assets ─────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ .

# Build the project (Vite produces 'dist' folder)
RUN npm run build

# ── Stage 3: Runtime image (nginx) ───────────────────────────
FROM nginx:1.27-alpine AS runtime

# Copy built static files
COPY --from=build /app/dist /usr/share/nginx/html

# Bake in nginx config with API + WebSocket proxy rules
COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
