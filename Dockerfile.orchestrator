FROM python:3.11-slim

WORKDIR /app

# System deps (gcc for building, + Playwright Chromium dependencies)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    # Playwright Chromium runtime deps
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdbus-1-3 \
    libdrm2 libxkbcommon0 libatspi2.0-0 libxcomposite1 libxdamage1 \
    libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 \
    libwayland-client0 \
    fonts-liberation fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install Playwright Chromium browser
RUN playwright install chromium

# App code
COPY orchestrator/ orchestrator/
COPY scripts/ scripts/

# Data & template dirs (will be mounted as volumes)
RUN mkdir -p data data/audiensi_docs data/templates data/ig_sessions

EXPOSE 8000

CMD ["uvicorn", "orchestrator.main:app", "--host", "0.0.0.0", "--port", "8000"]
