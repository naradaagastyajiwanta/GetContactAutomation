# syntax=docker/dockerfile:1

# ── Stage 1: Install dependencies ─────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app
RUN apk add --no-cache git python3 make g++
COPY whatsapp-service/package*.json ./
RUN npm ci --no-audit --progress=false --legacy-peer-deps

# ── Stage 2: Build TypeScript ─────────────────────────────────
FROM deps AS build
WORKDIR /app
COPY whatsapp-service/tsconfig.json ./
COPY whatsapp-service/src/ src/
RUN npm run build

# ── Stage 3: Production runtime (small) ──────────────────────
FROM node:20-alpine AS runtime
WORKDIR /app

# Only production deps (no devDependencies)
COPY whatsapp-service/package*.json ./
RUN apk add --no-cache git python3 make g++ \
    && npm ci --no-audit --progress=false --legacy-peer-deps --omit=dev \
    && apk del python3 make g++

# Copy compiled JS from build stage
COPY --from=build /app/dist ./dist

# Dirs for volume mounts
RUN mkdir -p auth_store auth_store_backup data \
    auth_store_device_1 auth_store_device_2 auth_store_device_3 \
    auth_store_device_4 auth_store_device_5

EXPOSE 3110
CMD ["node", "dist/index.js"]
