# Serper.dev API Key (for Google search to find IG handles, free tier 2500 queries/month)
SERPER_API_KEY=your-serper-api-key

# Apify API Key (backup IG scraping, optional)
APIFY_API_KEY=your-apify-api-key

# Instagram credentials (dedicated account for scraping, NOT your main account)
# Single account (legacy):
IG_USERNAME=your-ig-username
IG_PASSWORD=your-ig-password

# IG accounts for Playwright rotation are managed via the Dashboard UI
# (Settings → Instagram Accounts). No need to configure them here.

# How many minutes to cool down a rate-limited account (default: 30)
PW_ACCOUNT_COOLDOWN_MINUTES=30

# WhatsApp Service URL (Node.js Baileys service)
WA_SERVICE_URL=http://localhost:3100

# Webhook URL for incoming WA messages (Python orchestrator)
WEBHOOK_URL=http://localhost:8000/webhook/incoming

# Database path
DATABASE_PATH=data/getcontact.db

# Rate limiting
MAX_DAILY_CONVERSATIONS=20
MIN_MESSAGE_GAP_SECONDS=300
MAX_IG_PROFILES_PER_DAY=200
IG_REQUEST_DELAY_SECONDS=7

# Outreach hours (WIB = UTC+7)
OUTREACH_START_HOUR=7
OUTREACH_END_HOUR=22

# --- DMS Integration (dmsedu MySQL) — ENV ONLY, cannot be changed via Dashboard ---
# Host/IP of the DMS MySQL server (staging: 35.219.13.27, production: varies)
DMS_MYSQL_HOST=
# Port (default: 3306)
DMS_MYSQL_PORT=3306
# Database name (e.g. dev_staging_dmsedu)
DMS_MYSQL_DATABASE=
# Credentials
DMS_MYSQL_USER=
DMS_MYSQL_PASSWORD=

