# ==============================================================================
# GetContact AI Agent — Environment Variables Template
# ==============================================================================
# Copy this file to '.env' for local development or '.env.production' for Docker.
# FILL IN YOUR ACTUAL KEYS BELOW.

# ------------------------------------------------------------------------------
# 1. CORE CREDENTIALS (REQUIRED)
# ------------------------------------------------------------------------------

# OpenAI API Key for GPT-4o-mini and GPT-4o analysis
OPENAI_API_KEY=your_openai_api_key_here

# Serper.dev API Key for Google Search (Instagram handle finding)
SERPER_API_KEY=your_serper_api_key_here

# ------------------------------------------------------------------------------
# 2. INTERNAL SERVICE URLS (FOR DOCKER)
# ------------------------------------------------------------------------------

# URL for the WhatsApp Service (Node.js)
WA_SERVICE_URL=http://whatsapp:3100

# Webhook URL for the Orchestrator (used by WhatsApp Service to send replies back)
WEBHOOK_URL=http://orchestrator:8000/webhook/incoming

# ------------------------------------------------------------------------------
# 3. INSTAGRAM & SCRAPING (OPTIONAL / FALLBACKS)
# ------------------------------------------------------------------------------

# Instagram session cookie(s) for scraping (separate multiple with commas)
# Get from browser: F12 -> Application -> Cookies -> sessionid
IG_SESSION_ID=your_session_id_here

# Apify API Key (First-tier fallback for Instagram scraping)
APIFY_API_KEY=your_apify_api_key_here

# Scraping-Bot.io Credentials (Second-tier fallback)
SCRAPINGBOT_USERNAME=your_username
SCRAPINGBOT_API_KEY=your_api_key

# ------------------------------------------------------------------------------
# 4. DATABASE & STORAGE
# ------------------------------------------------------------------------------

# SQLite Database path inside the container
DATABASE_PATH=data/getcontact.db

# ------------------------------------------------------------------------------
# 5. OPERATION LIMITS & SCHEDULING
# ------------------------------------------------------------------------------

# Maximum new conversations to start per day
MAX_DAILY_CONVERSATIONS=20

# Minimum seconds between outgoing outreach messages
MIN_MESSAGE_GAP_SECONDS=300

# Outreach window (WIB Timezone / UTC+7)
OUTREACH_START_HOUR=7
OUTREACH_END_HOUR=22

# ------------------------------------------------------------------------------
# 6. EMAIL NOTIFICATIONS (SMTP/IMAP)
# ------------------------------------------------------------------------------

SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_USERNAME=your_email@domain.com
SMTP_PASSWORD=your_password
SMTP_USE_SSL=true

IMAP_HOST=your_imap_host
IMAP_PORT=993
IMAP_USERNAME=your_email@domain.com
IMAP_PASSWORD=your_password
IMAP_USE_SSL=true