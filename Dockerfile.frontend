# syntax=docker/dockerfile:1.6-labs

# Stage 1: Install dependencies using cache mounts for speed
FROM node:20-alpine AS deps
WORKDIR /app

# Copy package files (assuming context is project root)
COPY frontend/package*.json ./
# Use cache mount for faster builds
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --progress=false --legacy-peer-deps

# ── Stage 2: Build static assets ─────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ .

# Build the project (Vite produces 'dist' folder)
RUN npm run build

# ── Stage 3: Runtime image (small) ───────────────────────────
FROM node:20-alpine AS runtime
WORKDIR /app
RUN npm install -g serve
COPY --from=build /app/dist ./dist

# Standard port for the serve command in this project
EXPOSE 3010
CMD ["serve", "-s", "dist", "-l", "3010"]
