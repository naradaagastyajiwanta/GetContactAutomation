# =============================================================
# GetContact AI Agent — Production Environment
# =============================================================
# Copy this to .env.production and fill in your actual values

# OpenAI API Key (REQUIRED)
OPENAI_API_KEY=sk-your-openai-api-key

# Serper.dev API Key (REQUIRED for IG search)
SERPER_API_KEY=your-serper-api-key

# Apify API Key (optional — backup IG scraping)
APIFY_API_KEY=

# Instagram credentials (fallback — prefer Dashboard UI for multi-account setup)
IG_USERNAME=
IG_PASSWORD=
# Account cooldown after rate-limit (minutes)
PW_ACCOUNT_COOLDOWN_MINUTES=30

# Database path (inside container — mapped via volume)
DATABASE_PATH=data/getcontact.db

# Rate limiting
MAX_DAILY_CONVERSATIONS=20
MIN_MESSAGE_GAP_SECONDS=300
MAX_IG_PROFILES_PER_DAY=200
IG_REQUEST_DELAY_SECONDS=7

# Outreach hours (WIB = UTC+7)
OUTREACH_START_HOUR=7
OUTREACH_END_HOUR=22

# NOTE: WA_SERVICE_URL and WEBHOOK_URL are set in docker-compose.yml
# (they use Docker internal networking: http://whatsapp:3100 etc.)

# --- DMS Integration (dmsedu MySQL) — ENV ONLY, cannot be changed via Dashboard ---
# Contact the DMS team for production credentials.
DMS_MYSQL_HOST=
DMS_MYSQL_PORT=3306
DMS_MYSQL_DATABASE=
DMS_MYSQL_USER=
DMS_MYSQL_PASSWORD=

